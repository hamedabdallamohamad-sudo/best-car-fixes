rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'zjTXYYxb0rgW4AUPjL9NkuF0gD03';
    }
    function str(v, max) { return v is string && v.size() <= max; }
    function isNew() {
      return request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
    }

    match /{col}/{id} {
      allow read: if col in ['settings','services','products','categories','banners','videos'];
      allow write: if isAdmin();
    }

    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','address','items','total','status','createdAt'])
        && str(request.resource.data.name, 100)
        && str(request.resource.data.phone, 30)
        && str(request.resource.data.address, 300)
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && isNew();
      allow read, update, delete: if isAdmin();
    }

    match /appointments/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','car','year','service','date','time','location','notes','status','createdAt'])
        && str(request.resource.data.name, 100)
        && str(request.resource.data.phone, 30)
        && str(request.resource.data.car, 100)
        && str(request.resource.data.notes, 1000)
        && isNew();
      allow read, update, delete: if isAdmin();
    }

    match /partRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','car','year','part','image','status','createdAt'])
        && str(request.resource.data.name, 100)
        && str(request.resource.data.phone, 30)
        && str(request.resource.data.car, 100)
        && str(request.resource.data.part, 1000)
        && str(request.resource.data.image, 700000)
        && isNew();
      allow read, update, delete: if isAdmin();
    }
  }
}
